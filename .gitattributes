# =============================================================
# .gitattributes — Zenodo Release Filter
# Files/folders marked export-ignore are excluded from the
# GitHub release archive that Zenodo downloads.
# =============================================================
  
 
# --- Development & CI config ---
.gitattributes             export-ignore
.gitignore                 export-ignore
.github/                   export-ignore
.travis.yml                export-ignore
.circleci/                 export-ignore
.pre-commit-config.yaml    export-ignore

 
# --- Misc clutter ---
**/*.log                   export-ignore
**/*.tmp                   export-ignore
**/*.DS_Store              export-ignore
**/__pycache__/            export-ignore
**/*.pyc                   export-ignore
**/.*/                     export-ignore

# --- Other ---
**/*.patch                 export-ignore
**/*.C                     export-ignore
**/avg_data.py             export-ignore
**/get_data.py             export-ignore
**/*.sh                    export-ignore
**/README.md               export-ignore
**/*.h                     export-ignore
**/C_code/                 export-ignore
**/*.zip                   export-ignore